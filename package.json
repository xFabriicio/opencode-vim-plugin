{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@xfabriicio/opencode-vim-plugin",
  "version": "0.2.0",
  "description": "Vim prompt editing for OpenCode 2.",
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "vim"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xFabriicio/opencode-vim-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/xFabriicio/opencode-vim-plugin/issues"
  },
  "homepage": "https://github.com/xFabriicio/opencode-vim-plugin",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run script/build.ts",
    "typecheck": "tsc --noEmit",
    "check:keymap": "bun run script/check-keymap.ts",
    "check:adapter": "bun run script/check-v2-plugin.ts",
    "check": "bun run typecheck && bun run test && bun run check:keymap && bun run build && bun run check:adapter",
    "prepack": "bun run check"
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opencode/theme": ">=2.0.0",
    "@opentui/core": ">=0.5.10",
    "@opentui/keymap": ">=0.5.10",
    "@opentui/solid": ">=0.5.10"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.15",
    "@opencode/theme": "2.0.15",
    "@opentui/core": "0.5.10",
    "@opentui/keymap": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "latest",
    "solid-js": "1.9.15",
    "typescript": "^5.9.0"
  }
}
